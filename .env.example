# Local Postgres. `docker compose up -d postgres` starts one matching this URL.
DATABASE_URL=postgres://tda:tda@localhost:5432/tda_website
# Any long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Public address of the site, used in links inside emails (e.g. https://tillotsondesign.com).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Outgoing email (career applications). Any SMTP service: Microsoft 365, Google Workspace, or a
# sending service such as Resend. Leave SMTP_HOST empty to print emails to the log instead;
# applications are still saved under Leads and marked "not emailed".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=website@tillotsondesign.com

# Search engines may list the site only when this is true. Set it in Vercel (Production only)
# on launch day, when tillotsondesign.com points here. Until then every page says noindex.
ALLOW_INDEXING=

# A password on the whole public site until launch (src/proxy.ts). Set it in Vercel for
# Production and Preview; delete it (and redeploy) to open the site. The admin is not affected.
SITE_PASSWORD=

# Vercel Cron: the daily job that deletes leads older than six months (docs/forms-and-email.md)
CRON_SECRET=

# The newsletter (docs/newsletter.md): Resend sends issues and keeps the list. All three are
# needed to send to the list and to show the footer sign-up box; tests need the key and the from.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
NEWSLETTER_FROM=

# "Send to website" from the internal TDA app's Marketing tab (docs/app-sync.md). A long random
# string, set here and in the app's Convex environment as WEBSITE_SYNC_TOKEN. Empty: refused.
APP_SYNC_TOKEN=
