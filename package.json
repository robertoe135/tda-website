{
  "name": "tda-website",
  "version": "1.0.0",
  "description": "Public website for Tillotson Design Associates",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "migrate:inventory": "tsx scripts/migrate/inventory.ts",
    "migrate:fetch": "tsx scripts/migrate/fetch.ts",
    "migrate:extract": "tsx scripts/migrate/extract.ts",
    "migrate:import": "tsx scripts/migrate/import.ts",
    "migrate:pages": "tsx scripts/migrate/pages.ts",
    "migrate:photographers": "tsx scripts/migrate/photographers.ts",
    "migrate:merge-firms": "tsx scripts/migrate/merge-firms.ts",
    "migrate:firm-names": "tsx scripts/migrate/firm-names.ts",
    "migrate:drop-in-progress": "tsx scripts/migrate/drop-in-progress.ts",
    "migrate:people": "tsx scripts/migrate/people.ts",
    "migrate:check-redirects": "tsx scripts/migrate/check-redirects.ts",
    "team:import": "tsx scripts/team/import.ts",
    "team:worksheet": "tsx scripts/team/worksheet.ts",
    "team:headshots": "tsx scripts/team/headshots.ts",
    "media:inventory": "tsx scripts/media/inventory.ts",
    "media:scan": "tsx scripts/media/scan.ts",
    "media:import": "tsx scripts/media/import.ts",
    "projects:add": "tsx scripts/media/projects-to-add.ts",
    "media:publish": "tsx scripts/media/publish.ts",
    "media:check": "tsx scripts/media/check.ts",
    "media:why": "tsx scripts/media/why.ts",
    "content:check": "tsx scripts/content/check.ts",
    "locations:geocode": "tsx scripts/locations/geocode.ts",
    "newsletter:import": "tsx scripts/newsletter/import-subscribers.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/live-preview-react": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-vercel-blob": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@puckeditor/core": "0.23.0",
    "@vercel/blob": "2.3.1",
    "cross-env": "^7.0.3",
    "d3-geo": "3.1.1",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.91.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-email": "6.11.0",
    "sharp": "0.35.4",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "fast-xml-parser": "^5.11.2",
    "jsdom": "28.0.0",
    "mammoth": "1.8.0",
    "node-html-parser": "9.0.4",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20.18.1",
    "pnpm": "^9 || ^10 || ^11"
  }
}
